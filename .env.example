# PostgreSQL. El usuario NO debe ser superusuario ni tener BYPASSRLS,
# o las políticas RLS no se aplican. (En Neon, el rol por defecto sirve.)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/trux"

# Clave para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
