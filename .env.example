# Rol con el que corre la app y el seed. NO debe ser superusuario ni tener
# BYPASSRLS, o las políticas RLS no se aplican. En producción: trux_app
# (ver prisma/sql/app-role.sql).
DATABASE_URL="postgresql://trux_app:clave@localhost:5432/trux"

# Dueño de las tablas, solo para `npm run db:migrate`. Si se omite, se usa DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://dueno:clave@localhost:5432/trux"

# Clave para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Protege /api/cron/reset-demo (Vercel Cron la envía como Bearer).
CRON_SECRET=""
